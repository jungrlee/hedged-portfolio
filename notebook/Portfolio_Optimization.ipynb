    "    rc = x * (S @ x); rc = rc / rc.sum()\n",
    "    return -sr + 0.5 * np.sum((rc - rc.mean()) ** 2) * N\n",
    "\n",
    "\n",
    "x0 = np.array([np.mean(b_) for b_ in bounds]); x0 /= x0.sum()\n",
    "res = minimize(objective, x0, bounds=bounds, constraints=cons, method=\"SLSQP\",\n",
