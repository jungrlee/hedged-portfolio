    "w = np.round(res.x * 400) / 400            # 0.25% steps\n",
    "w = np.clip(w, [b_[0] for b_ in bounds], [b_[1] for b_ in bounds])\n",
    "diff = 1 - w.sum()\n",
    "w[ix[\"IEF\"]] += diff\n",
